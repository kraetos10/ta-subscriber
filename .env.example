# All settings below are optional and only used to bootstrap the database on
# first run. After that, change them in the web UI at http://localhost:8085

TA_URL=http://tubearchivist:8000
TA_TOKEN=

SCAN_INTERVAL_MINUTES=60
AUTOSTART=false
MAX_AGE_DAYS=7

# db | opml | file | env | ta
SOURCE=db

LOG_LEVEL=INFO
TZ=UTC
