# All settings below are optional and only used to bootstrap the database on
# first run. After that, change them in the web UI at http://localhost:8085

TA_URL=http://tubearchivist:8000
TA_TOKEN=

SCAN_INTERVAL_MINUTES=60
AUTOSTART=false
MAX_AGE_DAYS=7

# db | opml | file | env | ta
SOURCE=db

# Optional: post a Slack message (rich YouTube preview) when a new video is
# ingested. Create an Incoming Webhook in Slack and paste its URL here.
SLACK_WEBHOOK_URL=

# Optional: push a notification to ntfy (https://ntfy.sh) when a new video
# is ingested. Set a topic to enable it. NTFY_TOKEN is only needed if the
# topic is access-protected.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Public URL this app is reachable on from your phone. Set it to add a
# Download button to ntfy notifications.
PUBLIC_URL=

LOG_LEVEL=INFO
TZ=UTC
